# Next.js (pnpm workspace) image, built from the repo ROOT: `docker build -f apps/<app>/Dockerfile .`
# Needs `output: "standalone"` + `outputFileTracingRoot` in next.config; set APP on
# instantiation. Docs: templates/docker/README.md (base-image pinning rules included).

ARG APP=web

FROM node:24-slim AS build
ARG APP
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo
# Lockfile alone first, so the store layer stays cached until dependencies change.
COPY pnpm-lock.yaml ./
RUN pnpm fetch
COPY . .
RUN pnpm install --frozen-lockfile --offline
RUN pnpm --filter "./apps/${APP}" build

FROM node:24-slim AS runtime
ARG APP
ENV APP=${APP}
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/${APP}/.next/standalone ./
COPY --from=build /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
# Drop the next line if the app has no public/ directory.
COPY --from=build /repo/apps/${APP}/public ./apps/${APP}/public
USER node
EXPOSE 3000
# `exec` makes node PID 1 so SIGTERM reaches it (graceful shutdown on ECS).
CMD ["sh", "-c", "exec node \"apps/${APP}/server.js\""]
