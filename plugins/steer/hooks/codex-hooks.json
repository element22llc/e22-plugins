{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\" sh \"${PLUGIN_ROOT}/hooks/inject-standards.sh\" 1 6",
            "timeout": 10,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\" sh \"${PLUGIN_ROOT}/hooks/inject-standards.sh\" 2 6",
            "timeout": 10,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\" sh \"${PLUGIN_ROOT}/hooks/inject-standards.sh\" 3 6",
            "timeout": 10,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\" sh \"${PLUGIN_ROOT}/hooks/inject-standards.sh\" 4 6",
            "timeout": 10,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\" sh \"${PLUGIN_ROOT}/hooks/inject-standards.sh\" 5 6",
            "timeout": 10,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\" sh \"${PLUGIN_ROOT}/hooks/inject-standards.sh\" 6 6",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
