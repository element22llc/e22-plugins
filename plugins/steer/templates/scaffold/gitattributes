# LF everywhere, regardless of core.autocrlf — CRLF breaks sh scripts and Docker entrypoints.
# Rationale: /steer:reference conventions -> "Windows: use WSL".
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Binaries — never newline-normalized
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary

# Lockfiles — generated; keep out of diffs
pnpm-lock.yaml -diff
uv.lock        -diff
mise.lock      -diff

# CHANGELOG.md deliberately carries NO attribute. It is generated by `changie
# merge`, and entries live one-per-file under .changes/unreleased/, so concurrent
# PRs write different paths and never conflict — no merge driver is needed (union
# would splice multi-line entries together wrongly). `-diff` is wrong here too:
# the release diff is the one a reviewer most wants to read.
