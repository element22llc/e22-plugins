{
  // Shared VS Code defaults (Biome = format-on-save, matching `pnpm format` / CI). Per-user overrides: .vscode/settings.local.json (gitignored).
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Copilot: load the steer standards (.github/copilot-instructions.md, .agents/skills/) regardless of a teammate's defaults. Remove if Copilot is unused.
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.promptFiles": true
}
