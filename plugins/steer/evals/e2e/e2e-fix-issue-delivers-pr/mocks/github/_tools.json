{
  "tools": [
    {
      "name": "issue_read",
      "description": "Read a GitHub issue, its comments, labels, or sub-issues.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "issue_number": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "name": "list_issues",
      "description": "List issues in a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "perPage": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "name": "search_issues",
      "description": "Search issues across GitHub with a query string.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "perPage": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "name": "issue_write",
      "description": "Create a new or update an existing issue in a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "create",
              "update"
            ]
          },
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "issue_number": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "state_reason": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "method",
          "owner",
          "repo"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "add_issue_comment",
      "description": "Add a comment to a specific issue or pull request in a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "issue_number": {
            "type": "number"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo",
          "issue_number"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "create_pull_request",
      "description": "Create a new pull request in a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          }
        },
        "required": [
          "owner",
          "repo",
          "title",
          "head",
          "base"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "update_pull_request",
      "description": "Update an existing pull request in a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "pullNumber": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          }
        },
        "required": [
          "owner",
          "repo",
          "pullNumber"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "pull_request_read",
      "description": "Get information on a specific pull request in a GitHub repository (method: get, get_status, get_check_runs, get_reviews, ...).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "pullNumber": {
            "type": "number"
          }
        },
        "required": [
          "method",
          "owner",
          "repo",
          "pullNumber"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "merge_pull_request",
      "description": "Merge a pull request in a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "pullNumber": {
            "type": "number"
          },
          "merge_method": {
            "type": "string",
            "enum": [
              "merge",
              "squash",
              "rebase"
            ]
          }
        },
        "required": [
          "owner",
          "repo",
          "pullNumber"
        ],
        "additionalProperties": true
      }
    }
  ]
}
