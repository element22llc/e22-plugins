# LF everywhere, regardless of core.autocrlf — CRLF breaks sh scripts and Docker entrypoints.
# Rationale: /steer:reference conventions -> "Windows: use WSL".
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Binaries — never newline-normalized
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary

# Lockfiles — generated; keep out of diffs
pnpm-lock.yaml -diff
uv.lock        -diff
mise.lock      -diff

# Concurrent PRs all append under `### [Unreleased]`; union keeps both sides instead of conflict markers
CHANGELOG.md merge=union
