# Git-ignored local files Claude Code copies into each `claude --worktree` (gitignore syntax).
# Boot-critical config only — never caches, virtualenvs, or build output; they rebuild there.
# Rationale: steer rules "Secrets handling" and "Parallel worktrees".

# Local env / secrets (mirrors .gitignore)
.env
.env.local
.env.*.local

# Nested env for monorepo apps + infra
apps/*/.env
apps/*/.env.local
infra/.env
infra/.env.local

# mise machine overrides + per-user Claude Code settings
.mise.local.toml
.claude/settings.local.json
