# Python (FastAPI + uv) image, built from the repo ROOT: `docker build -f apps/<app>/Dockerfile .`
# Set APP and point CMD at the app's ASGI entry point. Docs: templates/docker/README.md.

ARG APP=api

FROM python:3.13-slim AS build
ARG APP
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
RUN pip install --no-cache-dir uv
# Manifests first, so the dependency layer stays cached until dependencies change.
COPY apps/${APP}/pyproject.toml apps/${APP}/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/${APP}/ ./
RUN uv sync --frozen --no-dev

FROM python:3.13-slim AS runtime
ENV PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY --from=build /app /app
RUN useradd --create-home app && chown -R app /app
USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
