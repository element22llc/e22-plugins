# Variable NAMES only, never secrets — copy to a git-ignored `.env` and fill it in.
# Rationale: /steer:reference conventions -> "Local services".

# Override only when several products collide on 5432; parallel worktrees of this
# repo get their own port from scripts/worktree-env.sh (it wins under `mise run`).
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app@localhost:5432/app  # host port must match POSTGRES_PORT
